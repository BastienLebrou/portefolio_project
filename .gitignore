# ALLOWLIST STRICTE — ne versionner QUE ce qui est listé ci-dessous.
# Le reste du portfolio local peut contenir des dossiers à NE PAS publier.
/*
!/.gitignore
!/README.md
!/GUIDE.md
!/SECURITY.md
!/.github/
!/assets/
!/scripts/
!/scrutech/

# Artefacts / environnements — jamais versionnés
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Données réelles / générées — non versionnées
/scrutech/packages/vegevigie/data/
/scrutech/applications/mini-data-centers/Data_alba/

# Simulations financières — NE JAMAIS publier (privé)
/analyse_financiere/
/scrutech/data/

# Généré par desktop/create_shortcut.py
/scrutech/desktop/src/scrutech_desktop/assets/scrutech.ico
